# Copy to .env.local or .env.beta. Never commit real secrets.
# APP_PORT also determines the default Compose project, network and volume names.
APP_PORT=8080
# Bind loopback by default; set the intended LAN interface IP explicitly for LAN use.
APP_BIND_ADDRESS=127.0.0.1
APP_HOST=localhost
APP_SCHEME=http
APP_ENV=development
POSTGRES_USER=sfl
POSTGRES_DB=sfl
POSTGRES_PASSWORD=replace-with-a-local-secret
COOKIE_SECURE=false
LAB_TIMEZONE=America/New_York
CANVAS_BASE_URL=https://instructure.charlotte.edu
CANVAS_API_TOKEN=
CANVAS_COURSE_ID=
CANVAS_SYNC_INTERVAL_SECONDS=3600
SQL_STATEMENT_TIMEOUT_MS=5000
SQL_MAX_ROWS=1000
# Optional restricted PostgreSQL LOGIN roles for the superadmin SQL workbench.
# Leave blank until provisioned; SQL execution fails closed without them.
SQL_READ_DATABASE_URL=
SQL_WRITE_DATABASE_URL=

# Optional email delivery. Empty settings leave invitations/recovery visibly unconfigured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
CANVAS_ENROLLMENT_URL=
# S3-compatible avatar storage. MinIO is built from the pinned full-console source.
# Console: same app origin at /storage/. S3 API remains internal to Compose.
MINIO_ROOT_USER=sfl-admin
MINIO_ROOT_PASSWORD=replace-with-a-local-storage-secret
S3_BUCKET=sfl-avatars
S3_REGION=us-east-1
# Optional override for an existing compatible service instead of the internal endpoint.
S3_ENDPOINT=http://minio:9000
